{
  "name": "interscript",
  "version": "2.4.5",
  "description": "Interscript JS bindings",
  "main": "./src/stdlib.js",
  "exports": {
    ".": "./src/stdlib.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interscript/interscript-js.git"
  },
  "author": "Ribose Inc. <open.source@ribose.com>",
  "scripts": {
    "test": "mocha",
    "lint": "eslint src test",
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js' 'test/**/*.js'",
    "prepareMaps": "cd ../ruby && bundle install --without secryst jsexec && bundle exec rake compile[javascript,../js/src/maps]"
  },
  "license": "BSD-2-Clause",
  "dependencies": {
    "xregexp": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^11.0.0",
    "prettier": "^3.9.6"
  },
  "files": [
    "src",
    "README.adoc",
    "LICENSE.md"
  ]
}
